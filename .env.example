# Environment variables for scraping system

# Database settings
DATABASE_TYPE=sqlite
DATABASE_PATH=scraping_system/data/scraping.db

# PostgreSQL settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scraping
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper_password

# MongoDB settings
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=scraping

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=scraper
RABBITMQ_PASSWORD=scraper_password

# Scraping settings
USE_PROXY=false
RATE_LIMIT=2.0
MAX_RETRIES=3
TIMEOUT=30

# API Keys (optional)
ZILLOW_API_KEY=
REALTOR_API_KEY=
REDFIN_API_KEY=
GOOGLE_MAPS_API_KEY=
CENSUS_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_DIR=scraping_system/logs
