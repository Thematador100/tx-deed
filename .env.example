# =====================================================
# WIN WITH DEEDS - ENVIRONMENT CONFIGURATION
# Enterprise Tax Deed Investment Platform
# =====================================================

# =====================================================
# SUPABASE (Required)
# =====================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =====================================================
# TELNYX - SMS/Voice Outreach (Required for Outreach)
# =====================================================
TELNYX_API_KEY=your-telnyx-api-key-v2-here
TELNYX_FROM_NUMBER=+18005551234
TELNYX_MESSAGING_PROFILE_ID=your-messaging-profile-id
TELNYX_CONNECTION_ID=your-connection-id

# =====================================================
# RESEND - Email Outreach (Required for Email)
# =====================================================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourwebsite.com
RESEND_FROM_NAME=Win With Deeds

# =====================================================
# ANTHROPIC - AI Analysis (Required for AI Features)
# =====================================================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# =====================================================
# OPENAI - Buyer Matching Embeddings (Required for Matching)
# =====================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# =====================================================
# SKIP TRACING - BatchSkipTracing (Required for Owner Data)
# =====================================================
BATCH_SKIP_TRACING_API_KEY=your-batch-skip-tracing-api-key

# Alternative: TLOxp (Premium Skip Tracing)
# TLOXP_API_KEY=your-tloxp-api-key

# =====================================================
# SMARTY STREETS - Address Validation (Optional)
# =====================================================
SMARTY_AUTH_ID=your-smarty-auth-id
SMARTY_AUTH_TOKEN=your-smarty-auth-token

# =====================================================
# STRIPE - Payments (Required for Subscriptions)
# =====================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =====================================================
# PROXY NETWORK - For Scraping (Recommended)
# =====================================================
# BrightData or Oxylabs for residential proxies
PROXY_URL=http://your-proxy-url:port
PROXY_USERNAME=your-proxy-username
PROXY_PASSWORD=your-proxy-password

# =====================================================
# APPLICATION SETTINGS
# =====================================================
NODE_ENV=development
VITE_APP_NAME=Win With Deeds
VITE_APP_URL=http://localhost:3000

# =====================================================
# REDIS (Optional - For Caching)
# =====================================================
REDIS_URL=redis://localhost:6379

# =====================================================
# SCRAPER SETTINGS
# =====================================================
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=60000
SCRAPER_RATE_LIMIT_MS=1000

# =====================================================
# SECURITY
# =====================================================
JWT_SECRET=your-very-secure-jwt-secret-here-min-32-chars
ENCRYPTION_KEY=your-encryption-key-for-api-keys-here

# =====================================================
# FEATURE FLAGS
# =====================================================
ENABLE_SKIP_TRACING=true
ENABLE_AI_ANALYSIS=true
ENABLE_SMS_OUTREACH=true
ENABLE_EMAIL_OUTREACH=true
ENABLE_BUYER_MATCHING=true
ENABLE_MARKETPLACE=true
ENABLE_SCRAPERS=true

# =====================================================
# COMPLIANCE
# =====================================================
ENABLE_10DLC_VERIFICATION=true
ENABLE_TCPA_COMPLIANCE=true
ENABLE_DNC_LIST_CHECK=true

# =====================================================
# ADMIN
# =====================================================
ADMIN_EMAIL=admin@yourwebsite.com
SUPPORT_EMAIL=support@yourwebsite.com

# =====================================================
# NOTES:
# - All API keys should be stored securely
# - For production, use environment-specific values
# - Never commit .env files to version control
# - Store production keys in Supabase Edge Function Secrets
# =====================================================
