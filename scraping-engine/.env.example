# Environment Configuration

NODE_ENV=development
LOG_LEVEL=debug

# API Configuration
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=*

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database Configuration (choose one)
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scraping
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=scraping

# Storage Type: json, postgres, mongodb, prisma
STORAGE_TYPE=json
DATA_DIR=./data

# AI Provider Configuration
# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-20241022

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Proxy Configuration
PROXY_LIST=
# Format: http://ip:port,http://ip:port or http://user:pass@ip:port

# BrightData
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
BRIGHTDATA_API_KEY=

# Oxylabs
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Smartproxy
SMARTPROXY_USERNAME=
SMARTPROXY_PASSWORD=

# Scraping Configuration
HEADLESS=true
MAX_CONCURRENT_BROWSERS=5
BROWSER_TIMEOUT=30000
MAX_RETRIES=3
RESPECT_ROBOTS_TXT=true
DEFAULT_DELAY=1000
BLOCK_RESOURCES=true

# Rate Limiting
MAX_CONCURRENT=5
MIN_TIME_BETWEEN_REQUESTS=1000

# Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3

# Alerting Configuration
# Email
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# SMS (Twilio)
ALERT_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_SMS_TO=

# Webhook
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

# Sentry Error Tracking
SENTRY_DSN=

# Feature Flags
ENABLE_FINGERPRINT_SPOOFING=true
ENABLE_PROXY_ROTATION=true
ENABLE_AI_EXTRACTION=true
ENABLE_SCREENSHOTS=false
ENABLE_MONITORING=true
