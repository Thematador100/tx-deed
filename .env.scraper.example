# ==================================================================
# SCRAPER CONFIGURATION
# Copy this file to .env.scraper and fill in your credentials
# ==================================================================

# AI Analysis API Keys (Choose one or both)
# Get Anthropic key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# OR use OpenAI (alternative to Anthropic)
# Get OpenAI key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Perplexity for AI web search (optional but recommended for discovery)
# Get key from: https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-...

# Proxy Services (Optional but highly recommended for scale)
# Get BrightData account: https://brightdata.com/
BRIGHTDATA_USERNAME=your-username-here
BRIGHTDATA_PASSWORD=your-password-here

# Alternative proxy services (optional)
# OXYLABS_USERNAME=
# OXYLABS_PASSWORD=
# SMARTPROXY_USERNAME=
# SMARTPROXY_PASSWORD=

# CAPTCHA Solving Services (Optional)
# Get 2Captcha key: https://2captcha.com/
# TWOCAPTCHA_API_KEY=

# Get Anti-Captcha key: https://anti-captcha.com/
# ANTICAPTCHA_API_KEY=

# Performance Tuning (Optional)
# MAX_WORKERS=10
# REQUEST_DELAY_MS=2000
# MAX_RETRIES=3
# TIMEOUT_MS=30000
