# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/taxsales.db

# Scraping Configuration
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPING_DELAY_MIN=2
SCRAPING_DELAY_MAX=5
MAX_RETRIES=3

# Proxy Configuration (optional - for production)
USE_PROXY=false
PROXY_URL=

# LLM Configuration (for AI-powered extraction)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Scheduling
SCRAPE_SCHEDULE_CRON=0 2 * * *  # Daily at 2 AM

# Monitoring
LOG_LEVEL=INFO
