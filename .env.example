# Supabase Configuration
# Get these from your Supabase project settings at https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration
# Get this from your Stripe dashboard at https://dashboard.stripe.com/apikeys
# Use test key (pk_test_...) for development, live key (pk_live_...) for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Template Configuration (Optional - for Horizons.ai template)
# Only needed if using the template banner/redirect feature
# NODE_ENV=production
# TEMPLATE_BANNER_SCRIPT_URL=https://your-banner-script-url
# TEMPLATE_REDIRECT_URL=https://your-redirect-url
