# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Melissa Data API (Prepaid License)
MELISSA_DATA_LICENSE_KEY=your_melissa_data_license_key_here
MELISSA_DATA_API_URL=https://personator.melissadata.net/v3/WEB/ContactVerify/doContactVerify

# Property Data APIs (Multi-Source Integration)
# Primary: Melissa Data (prepaid)
# Fallback options for cost optimization

# Attom Data API
ATTOM_API_KEY=your_attom_api_key_here
ATTOM_API_URL=https://api.gateway.attomdata.com/propertyapi/v1.0.0

# CoreLogic API
CORELOGIC_API_KEY=your_corelogic_api_key_here
CORELOGIC_API_URL=https://api.corelogic.com/property

# Zillow API (via RapidAPI or direct)
ZILLOW_API_KEY=your_zillow_api_key_here

# Redfin Data Access
REDFIN_API_KEY=your_redfin_api_key_here

# PropStream API
PROPSTREAM_API_KEY=your_propstream_api_key_here
PROPSTREAM_API_URL=https://api.propstreampro.com

# Regrid (for parcel data)
REGRID_API_KEY=your_regrid_api_key_here
REGRID_API_URL=https://app.regrid.com/api/v1

# DataTree by First American
DATATREE_USERNAME=your_datatree_username
DATATREE_PASSWORD=your_datatree_password

# Proxy Configuration for Anti-Blocking
# Residential Proxy Services
BRIGHT_DATA_USERNAME=your_brightdata_username
BRIGHT_DATA_PASSWORD=your_brightdata_password
BRIGHT_DATA_HOST=brd.superproxy.io
BRIGHT_DATA_PORT=22225

# Oxylabs Residential Proxies
OXYLABS_USERNAME=your_oxylabs_username
OXYLABS_PASSWORD=your_oxylabs_password
OXYLABS_HOST=pr.oxylabs.io
OXYLABS_PORT=7777

# SmartProxy
SMARTPROXY_USERNAME=your_smartproxy_username
SMARTPROXY_PASSWORD=your_smartproxy_password
SMARTPROXY_HOST=gate.smartproxy.com
SMARTPROXY_PORT=7000

# Rotating Proxy Service (Fallback)
PROXY_PROVIDER=brightdata # Options: brightdata, oxylabs, smartproxy, custom
PROXY_ROTATION_ENABLED=true
PROXY_ROTATION_INTERVAL=300000 # 5 minutes in milliseconds

# CAPTCHA Solving Services
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here
ANTICAPTCHA_API_KEY=your_anticaptcha_api_key_here
CAPTCHA_SOLVER_PROVIDER=2captcha # Options: 2captcha, anticaptcha

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_REQUESTS_PER_HOUR=100
RATE_LIMIT_CONCURRENT_REQUESTS=5

# Scraping Configuration
SCRAPING_ENABLED=true
SCRAPING_HEADLESS=true
SCRAPING_TIMEOUT=30000
SCRAPING_RETRY_ATTEMPTS=3
SCRAPING_RETRY_DELAY=5000

# OpenAI for Analysis
OPENAI_API_KEY=your_openai_api_key_here

# Google AI
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# DeepSeek AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com

# Stripe Payment Processing
STRIPE_PUBLIC_KEY=your_stripe_public_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Email Service (SendGrid/Mailgun)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM_ADDRESS=noreply@winwithdeeds.com

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Analytics & Monitoring
SENTRY_DSN=your_sentry_dsn_here

# Development/Production Mode
NODE_ENV=development
VITE_APP_ENV=development

# Database
DATABASE_URL=your_database_connection_string

# Redis Cache (for caching API responses and proxy rotation)
REDIS_URL=your_redis_url_here
REDIS_CACHE_TTL=3600

# Feature Flags
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_QUANT_MODELS=true
ENABLE_PDF_REPORTS=true
ENABLE_DISTRESSED_DETECTION=true

# Cost Optimization
API_COST_OPTIMIZATION_ENABLED=true
API_FALLBACK_ORDER=melissa,attom,corelogic,propstream,regrid

# API Pricing (cost per request in USD)
API_COST_MELISSA=0.10
API_COST_ATTOM=0.15
API_COST_CORELOGIC=0.20
API_COST_PROPSTREAM=0.12
API_COST_REGRID=0.08
